{
  "name": "homequarters",
  "version": "0.1.1",
  "description": "HQ: a local website for keeping up with your own repo. Reads what your project writes; runs no code from it.",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drewkhoury/homequarters.git"
  },
  "bugs": {
    "url": "https://github.com/drewkhoury/homequarters/issues"
  },
  "homepage": "https://github.com/drewkhoury/homequarters#readme",
  "bin": {
    "hq": "bin/hq.mjs"
  },
  "exports": {
    ".": "./lib/ui-api.mjs",
    "./testing": "./testing.mjs",
    "./unstable": "./unstable.mjs",
    "./internal/*": "./*",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "lib",
    "pages",
    "static",
    "theme",
    "schema",
    "server.mjs",
    "problem.mjs",
    "problem-backfill.mjs",
    "backlog.mjs",
    "dora.mjs",
    "dora-fetch.mjs",
    "demo.json",
    "README.md",
    "testing.mjs",
    "unstable.mjs",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test test/*.test.mjs",
    "prepublishOnly": "HQ_RACE_ROUNDS=5 npm test"
  },
  "dependencies": {
    "highlight.js": "11.12.0",
    "marked": "18.0.14"
  },
  "keywords": [
    "dashboard",
    "repo",
    "delivery",
    "ci",
    "backlog",
    "decisions",
    "testing",
    "local"
  ]
}
